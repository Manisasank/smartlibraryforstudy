# Smart Library Example Environment Configuration
# Copy this file to .env and configure strong production secrets.

# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
SMARTLIB_SECRET_KEY=replace-with-a-long-random-secret
SMARTLIB_DB_PATH=instance/smart_library.sqlite
SMARTLIB_LOAN_DAYS=14
SMARTLIB_MAX_BOOKS=3
SMARTLIB_FINE_RATE=2.0

# Flask Security & Environment Flags
FLASK_DEBUG=False
FLASK_COOKIE_SECURE=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# CORS & Rate Limiting (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
RATELIMIT_STORAGE_URI=memory://
